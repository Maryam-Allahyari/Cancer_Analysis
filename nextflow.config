params {
    raw_dir       = "${projectDir}/Data/Raw"
    driver_genes  = "${projectDir}/resources/driver_genes.txt"
    outdir        = "${projectDir}/results"

    // cleaning
    min_patients  = 15
    min_af        = 0.05
    min_alt_reads = 3

    // modelling
    n_genes       = 2000
    seed          = 42
    tune_iter     = 10
}

process {
    memory = '6 GB'
}

profiles {
    // uses whatever python is on the PATH (e.g. an activated conda env)
    standard {
        process.executor = 'local'
    }

    docker {
        docker.enabled    = true
        process.container = 'cancer-origin:1.0'
    }

    // for an HPC cluster with SLURM; Apptainer can run the same Docker image
    slurm {
        process.executor       = 'slurm'
        process.time           = '2h'
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        process.container      = 'docker://cancer-origin:1.0'
    }
}

manifest {
    name        = 'cancer-origin'
    description = 'Predicting the tissue of origin of metastatic tumours from POG570 data'
    author      = 'Maryam Allahyari'
    version     = '1.0'
}
